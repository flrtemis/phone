<?xml version="1.0" encoding="utf-8"?>
<!-- The server URL and token live in the app's private preferences. Neither
     belongs in a cloud backup: a token is a bearer credential for a microphone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
